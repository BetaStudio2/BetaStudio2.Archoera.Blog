{"default":{"content":"<style>\n.post-callout{\n  margin:0 0 32px;padding:24px 28px;\n  background:linear-gradient(135deg, rgba(96,165,250,.06) 0%, rgba(96,165,250,.02) 100%);\n  border:1px solid rgba(96,165,250,.12);\n  border-radius:10px;\n}\n.post-callout p{\n  font-size:17px;line-height:1.85;color:#c8d0da;margin:0;\n}\n.post-callout p + p{margin-top:10px}\n.post-tag-cloud{\n  display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 20px;\n}\n.post-tag{\n  display:inline-block;font-size:13px;\n  padding:5px 14px;border-radius:16px;\n  background:rgba(96,165,250,.08);color:#93c5fd;\n  border:1px solid rgba(96,165,250,.15);\n  transition:background .2s,border-color .2s;\n}\n.post-tag:hover{\n  background:rgba(96,165,250,.16);\n  border-color:rgba(96,165,250,.3);\n}\n.post-process-flow{\n  margin:20px 0 28px;padding:0;\n}\n.post-process-step{\n  display:flex;align-items:flex-start;gap:14px;\n  padding:14px 0 14px 6px;\n  position:relative;\n}\n.post-process-step:not(:last-child)::before{\n  content:'';position:absolute;\n  left:13px;top:36px;bottom:0;\n  width:1px;\n  background:rgba(255,255,255,.08);\n}\n.post-process-dot{\n  width:10px;height:10px;border-radius:50%;\n  background:rgba(96,165,250,.5);\n  box-shadow:0 0 8px rgba(96,165,250,.25);\n  flex-shrink:0;margin-top:6px;\n}\n.post-process-body h4{\n  font-size:15px;font-weight:600;margin:0 0 4px;color:#e2e6ed;\n}\n.post-process-body p{\n  font-size:14px;color:#7f8798;margin:0;line-height:1.6;\n}\n\n.post-audio-widget{\n  margin:32px 0;\n  padding:16px 20px;\n  background:rgba(255,255,255,.03);\n  border:1px solid rgba(255,255,255,.08);\n  border-radius:12px;\n}\n.post-audio-top{\n  display:flex;align-items:center;gap:14px;\n}\n.post-audio-btn{\n  width:40px;height:40px;border-radius:50%;\n  border:1px solid rgba(96,165,250,.25);\n  background:rgba(96,165,250,.08);\n  color:#93c5fd;cursor:pointer;\n  display:flex;align-items:center;justify-content:center;\n  flex-shrink:0;transition:background .2s,border-color .2s;\n  padding:0;\n}\n.post-audio-btn:hover{\n  background:rgba(96,165,250,.18);\n  border-color:rgba(96,165,250,.45);\n}\n.post-audio-btn svg{width:16px;height:16px}\n.post-audio-info{flex:1;min-width:0}\n.post-audio-title{\n  font-size:14px;font-weight:600;color:#e2e6ed;\n  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\n}\n.post-audio-artist{\n  font-size:12px;color:#7f8798;margin-top:2px;\n}\n.post-audio-time{\n  font-size:12px;color:#6b7280;flex-shrink:0;\n  font-variant-numeric:tabular-nums;\n}\n.post-audio-vol{\n  display:flex;align-items:center;gap:6px;flex-shrink:0;\n}\n.post-audio-vol-btn{\n  width:28px;height:28px;border:none;background:none;\n  color:#6b7280;cursor:pointer;display:flex;align-items:center;\n  justify-content:center;padding:0;flex-shrink:0;\n}\n.post-audio-vol-btn:hover{color:#93c5fd}\n.post-audio-vol-btn svg{width:16px;height:16px}\n.post-audio-vol-slider{\n  -webkit-appearance:none;appearance:none;\n  width:64px;height:3px;border-radius:2px;\n  background:rgba(255,255,255,.1);\n  outline:none;cursor:pointer;\n}\n.post-audio-vol-slider::-webkit-slider-thumb{\n  -webkit-appearance:none;appearance:none;\n  width:10px;height:10px;border-radius:50%;\n  background:#93c5fd;cursor:pointer;\n}\n.post-audio-vol-slider::-moz-range-thumb{\n  width:10px;height:10px;border-radius:50%;\n  background:#93c5fd;cursor:pointer;border:none;\n}\n.post-audio-track{\n  margin-top:12px;height:4px;\n  background:rgba(255,255,255,.06);\n  border-radius:2px;cursor:pointer;\n  position:relative;\n}\n.post-audio-track-filled{\n  height:100%;border-radius:2px;\n  background:linear-gradient(90deg, #60a5fa, #93c5fd);\n  width:0%;transition:width .1s linear;\n}\n.post-audio-track:hover .post-audio-track-filled{\n  background:linear-gradient(90deg, #93c5fd, #a5d0ff);\n}\n.post-audio-track-thumb{\n  position:absolute;top:50%;transform:translate(-50%,-50%);\n  width:10px;height:10px;border-radius:50%;\n  background:#93c5fd;opacity:0;\n  transition:opacity .15s;\n}\n.post-audio-track:hover .post-audio-track-thumb{opacity:1}\n\n/* ── Section refinement ── */\n.blog-post .post-section{margin-bottom:48px}\n.blog-post .post-section h2{\n  position:relative;padding-left:18px;\n}\n.blog-post .post-section h2::before{\n  content:'';position:absolute;left:0;top:4px;bottom:4px;\n  width:3px;border-radius:2px;\n  background:linear-gradient(180deg, #60a5fa 0%, rgba(96,165,250,.25) 100%);\n}\n.blog-post .post-section h3{\n  color:#c8d0da;font-size:17px;font-weight:600;\n  margin:24px 0 10px;letter-spacing:.2px;\n}\n.blog-post .post-section p{\n  color:#b0b8c4;line-height:1.85;margin:0 0 14px;\n}\n\n/* ── Callout polish ── */\n.post-callout{\n  border-left:3px solid rgba(96,165,250,.25);\n}\n\n/* ── Tag cloud polish ── */\n.post-tag{\n  transition:all .25s ease;\n}\n.post-tag:hover{\n  background:rgba(96,165,250,.2);\n  border-color:rgba(96,165,250,.35);\n  transform:translateY(-1px);\n  box-shadow:0 4px 12px rgba(96,165,250,.12);\n}\n\n/* ── Process flow polish ── */\n.post-process-flow{margin:24px 0 32px}\n.post-process-step:not(:last-child)::before{\n  background:linear-gradient(180deg, rgba(96,165,250,.25), rgba(255,255,255,.03));\n}\n.post-process-dot{\n  width:12px;height:12px;margin-top:5px;\n  background:rgba(96,165,250,.55);\n  box-shadow:0 0 10px rgba(96,165,250,.3);\n  transition:box-shadow .3s;\n}\n.post-process-step:hover .post-process-dot{\n  box-shadow:0 0 16px rgba(96,165,250,.5);\n}\n.post-process-body h4{font-size:16px;color:#e8ecf2;letter-spacing:.2px}\n\n/* ── Divider refinement ── */\n.blog-post .post-divider{\n  border:none;height:1px;margin:44px 0 36px;\n  background:linear-gradient(90deg, transparent 0%, rgba(255,255,255,.1) 20%, rgba(96,165,250,.15) 50%, rgba(255,255,255,.1) 80%, transparent 100%);\n}\n\n/* ── Blockquote highlight ── */\n.blog-post .post-blockquote-highlight{\n  position:relative;\n  padding:28px 28px 28px 32px;\n  margin:24px 0 8px;\n  background:linear-gradient(135deg, rgba(96,165,250,.08) 0%, rgba(96,165,250,.03) 100%);\n  border-left:3px solid rgba(96,165,250,.35);\n  border-radius:0 10px 10px 0;\n}\n.blog-post .post-blockquote-highlight::before{\n  content:'\\201C';\n  position:absolute;top:8px;left:14px;\n  font-size:42px;line-height:1;\n  color:rgba(96,165,250,.12);\n  font-family:Georgia,\"Times New Roman\",serif;\n  pointer-events:none;\n}\n.blog-post .post-blockquote-highlight p{\n  font-size:16px;color:#c8d0da;line-height:1.9;\n  position:relative;z-index:1;\n}\n.blog-post .post-blockquote-highlight p:first-child{\n  font-size:18px;font-weight:500;color:#e2e6ed;\n}\n\n/* ── Footer polish ── */\n.blog-post .post-footer{\n  margin-top:48px;padding-top:24px;\n  border-top:1px solid rgba(255,255,255,.06);\n}\n.blog-post .post-copyright{\n  font-size:12px;color:#4a5060;letter-spacing:.3px;\n}\n</style>\n\n<article class=\"blog-post\" data-title=\"作者想说：从本地编辑器到一座小站\">\n\n  <header class=\"post-header\">\n    <p class=\"post-meta\">\n      <span class=\"post-date\">2026-07-20</span>\n      <span> · </span>\n      <span class=\"post-category\">介绍 / 开发日记</span>\n      <span> · </span>\n      <span class=\"post-author\" data-author-uuid=\"30be-c219-f6fb-1356\">BetaStudio2</span>\n    </p>\n    <h1 class=\"post-title\">作者想说：从本地编辑器到一座小站</h1>\n    <p class=\"post-lead\">\n      写代码、写文案这件事，从一开始就是给自己找的——一块在无数次实验、无数次推翻之后，还能保持运转的小角落。\n    </p>\n  </header>\n\n  <div class=\"post-audio-widget\" id=\"audioWidget\">\n    <div class=\"post-audio-top\">\n      <button class=\"post-audio-btn\" id=\"audioBtn\" title=\"播放\">\n        <svg id=\"playIcon\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg>\n        <svg id=\"pauseIcon\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"display:none\"><path d=\"M6 19h4V5H6v14zm8-14v14h4V5h-4z\"/></svg>\n      </button>\n      <div class=\"post-audio-info\">\n        <div class=\"post-audio-title\">Azure Lag - Astral Sunset</div>\n        <div class=\"post-audio-artist\">开心点嘛</div>\n      </div>\n      <span class=\"post-audio-time\" id=\"audioTime\">0:00 / 0:00</span>\n      <div class=\"post-audio-vol\">\n        <button class=\"post-audio-vol-btn\" id=\"volBtn\" title=\"静音\">\n          <svg id=\"volOn\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z\"/></svg>\n          <svg id=\"volOff\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"display:none\"><path d=\"M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z\"/></svg>\n        </button>\n        <input type=\"range\" class=\"post-audio-vol-slider\" id=\"volSlider\" min=\"0\" max=\"100\" value=\"80\" />\n      </div>\n    </div>\n    <div class=\"post-audio-track\" id=\"audioTrack\">\n      <div class=\"post-audio-track-filled\" id=\"audioProgress\"></div>\n      <div class=\"post-audio-track-thumb\" id=\"audioThumb\"></div>\n    </div>\n  </div>\n  <audio id=\"audioEl\" preload=\"metadata\" style=\"display:none\">\n    <source src=\"/static/documents/%E4%BB%8B%E7%BB%8D/%E5%BC%80%E5%8F%91%E6%97%A5%E8%AE%B0/%E4%BD%9C%E8%80%85%E6%83%B3%E8%AF%B4/assets/music/Azure%20Lag%20-%20Astral%20Sunset.mp3\" type=\"audio/mpeg\">\n  </audio>\n\n  <script>\n  (function(){\n    var el=document.getElementById('audioEl');\n    var btn=document.getElementById('audioBtn');\n    var playI=document.getElementById('playIcon');\n    var pauseI=document.getElementById('pauseIcon');\n    var timeD=document.getElementById('audioTime');\n    var track=document.getElementById('audioTrack');\n    var prog=document.getElementById('audioProgress');\n    var thumb=document.getElementById('audioThumb');\n    var dur=0;\n    var lastVol=80;\n\n    function fmt(s){s=s|0;var m=(s/60)|0;var sec=s%60;return m+':'+(sec<10?'0':'')+sec}\n    function setVolUI(v){\n      document.getElementById('volSlider').value=v;\n      var on=document.getElementById('volOn'),off=document.getElementById('volOff');\n      on.style.display=v>0?'':'none';off.style.display=v>0?'none':'';\n    }\n\n    el.addEventListener('loadedmetadata',function(){dur=el.duration;timeD.textContent='0:00 / '+fmt(dur)});\n    el.addEventListener('timeupdate',function(){\n      var p=el.currentTime;var pc=dur?(p/dur*100):0;\n      prog.style.width=pc+'%';thumb.style.left=pc+'%';\n      timeD.textContent=fmt(p)+' / '+fmt(dur);\n    });\n    el.addEventListener('ended',function(){playI.style.display='';pauseI.style.display='none'});\n    el.addEventListener('play',function(){playI.style.display='none';pauseI.style.display=''});\n    el.addEventListener('pause',function(){playI.style.display='';pauseI.style.display='none'});\n\n    btn.addEventListener('click',function(){el.paused?el.play():el.pause()});\n    track.addEventListener('click',function(e){\n      var r=track.getBoundingClientRect();var x=e.clientX-r.left;\n      var pc=Math.min(1,Math.max(0,x/r.width));\n      el.currentTime=pc*dur;\n    });\n\n    document.getElementById('volSlider').addEventListener('input',function(){\n      var v=this.value/100;el.volume=v;lastVol=this.value;\n      setVolUI(this.value);\n    });\n    document.getElementById('volBtn').addEventListener('click',function(){\n      if(el.volume>0){lastVol=el.volume*100;el.volume=0;setVolUI(0)}\n      else{el.volume=lastVol/100;setVolUI(lastVol)}\n    });\n    el.volume=0.8;\n  })();\n  </script>\n\n  <section class=\"post-section\">\n    <div class=\"post-callout\">\n      <p>其实，本意并不是为了一个网站而做一个网站的。</p>\n      <p>那些脚本、那个本地编辑器、那堆被打回原形又重新组织的想法，它们早就在那儿了，只是从没真正站到台前过。</p>\n    </div>\n  </section>\n\n  <section class=\"post-section\">\n    <h2 id=\"about\">关于这个站点</h2>\n    <p>\n      <strong>BetaStudio2</strong>，这个站点的主开发者，也是这些文字、这些代码、这些反复推敲背后那个最较真的人。\n      当你看到这个文案时，说不定他正和协作者奋力修 bug，准备新的文案呢。\n    </p>\n    <p>\n      搭建的过程零零碎碎，前后也花了不少时间，与其让它们继续躺在硬盘里吃灰，倒不如拿出来建个站，也算给它们一个能被看见的去处。\n      所以你看到的这些页面，并不是什么宏大计划，更像是一段被搬上了台面的私人笔记。\n    </p>\n  </section>\n\n  <section class=\"post-section\">\n    <h2 id=\"predecessor\">前身：一个\"被废弃\"项目的改造品</h2>\n    <p>\n      如果往回翻一翻，你会发现这个站点的前身其实是一个所谓被\"废弃\"的项目的改造品罢了，虽然它仍然是不完美的。\n      那是一个完全跑在浏览器里的本地编辑器：字体切换、Markdown 渲染、Live2D、插件市场、模板库、任务视图、音乐盒——所有能折腾的东西，几乎都被我塞进去了。\n    </p>\n\n    <p>细看下来，光是官方插件就能数出一长串：</p>\n    <div class=\"post-tag-cloud\">\n      <span class=\"post-tag\">常数查询</span>\n      <span class=\"post-tag\">化学元素周期表</span>\n      <span class=\"post-tag\">随机数生成器</span>\n      <span class=\"post-tag\">白噪音</span>\n      <span class=\"post-tag\">天气预报</span>\n      <span class=\"post-tag\">每日运势</span>\n      <span class=\"post-tag\">单位换算</span>\n      <span class=\"post-tag\">公式计算</span>\n    </div>\n    <p>\n      每加一个，都要在不破坏既有结构的前提下，安插进一个原本没设计扩展点的内核里。\n      模板库也是，从日记、笔记、心得这种日常写作用的轻量模板，到合同、提案、PRD、周报这种偏向正式文档的模板，一点一点往上堆。\n      功能堆得再多，回头看也不过是一件陪我熬日子的工具。\n    </p>\n  </section>\n\n  <section class=\"post-section\">\n    <h2 id=\"evolution\">蜕变：从单页到全栈</h2>\n\n    <p>\n      它陪我度过了很长一段从研究课题到日常写作的过渡期，也见证了无数次\"写到一半推翻重写\"的惨案。\n      但它毕竟只是一个本地的壳，没有入口，没有归处，也没有\"被另一个人看见\"的可能。\n    </p>\n    <p>于是就有了现在的站点：</p>\n\n    <div class=\"post-process-flow\">\n      <div class=\"post-process-step\">\n        <div class=\"post-process-dot\"></div>\n        <div class=\"post-process-body\">\n          <h4>拆解</h4>\n          <p>把那块本地编辑器拆开，留下内核。</p>\n        </div>\n      </div>\n      <div class=\"post-process-step\">\n        <div class=\"post-process-dot\"></div>\n        <div class=\"post-process-body\">\n          <h4>重构</h4>\n          <p>从纯前端的单页，搬到了 <strong>Vue 3 + TypeScript</strong> 的工程结构上。</p>\n        </div>\n      </div>\n      <div class=\"post-process-step\">\n        <div class=\"post-process-dot\"></div>\n        <div class=\"post-process-body\">\n          <h4>接入</h4>\n          <p>在背后接上 <strong>Express</strong> 和 <strong>SQLite</strong>，撑起了账户、文档、回收站这些原本不存在的服务。</p>\n        </div>\n      </div>\n      <div class=\"post-process-step\">\n        <div class=\"post-process-dot\"></div>\n        <div class=\"post-process-body\">\n          <h4>裁剪</h4>\n          <p>一边拆，一边补，一边砍掉那些在多人场景下已经不合时宜的边角。</p>\n        </div>\n      </div>\n    </div>\n\n    <p>\n      等这些都收拾完，原本那个\"本地编辑器\"其实已经换了一副骨架。\n      所以严格说起来，你现在看到的不是\"一个新项目\"，而是那个本地编辑器的一次<strong>重新发布</strong>。\n    </p>\n  </section>\n\n  <section class=\"post-section\">\n    <h2 id=\"origin\">内容的来处</h2>\n    <p>\n      你能在这边读到的关于 Kimi K3、长程编程、长文档、心得笔记，几乎每一篇，最初都是在那块本地编辑器里被敲出来的。\n      我只是把草稿箱、废稿箱、试验场，按主题重新整理了一遍，又加上了账户、搜索、导航、回收站这些\"让站点像个站点\"的零件。\n    </p>\n    <p>\n      每一篇都还带着当时敲下它的那台电脑、那个凌晨、那首循环的歌的影子，只是被重新归档、重新打磨，重新摆到了能被人翻到的位置上。\n    </p>\n  </section>\n\n  <section class=\"post-section\">\n    <h2 id=\"future\">未来的期许</h2>\n    <p>\n      如果未来这里能攒下一些真正有用，或者至少有点温度的内容，那就已经超出我最开始那个\"让硬盘里的东西见见光\"的预期了。\n      剩下的，就一边写，一边慢慢来吧。\n    </p>\n  </section>\n\n  <section class=\"post-section\">\n    <hr class=\"post-divider\" />\n\n    <p>\n      不过话说回来，再用心，也拦不住时间。或许，总有那么一段时间，这个小站会随着时间的流逝，逐渐泯灭。\n      这或许是每个人都不愿意经历的结局。但是至少——现在的它，在维护与改进之下，在逐渐变好。\n    </p>\n\n    <blockquote class=\"post-blockquote post-blockquote-highlight\">\n      <p>\"开心点嘛。\"</p>\n      <p>至少现在的我们，都在变好。对吧。</p>\n    </blockquote>\n  </section>\n\n  <footer class=\"post-footer\">\n    <p class=\"post-copyright\">本文为个人随笔，版权所有 &copy; BetaStudio2</p>\n  </footer>\n\n</article>","meta":{"id":"author-notes","title":"作者想说：从本地编辑器到一座小站","subtitle":"关于 WebWord 的前世今生——一次从私人工具到公共站点的蜕变记录","category":"介绍/开发日记/作者想说","tags":["开发日记","WebWord","BetaStudio2","本地编辑器","Vue 3","TypeScript","Express","SQLite","全栈","开源"],"author_uuid":"a2c9-2c8d-0967-620e","version":"v1.0.0","status":"published","format":"domt","filename":"作者想说.domt","language":"zh-CN","created":"2026-07-20","updated":"2026-07-20","published_at":"2026-07-20T00:00:00+08:00","description":"BetaStudio2 讲述 WebWord 从本地编辑器到全栈站点的蜕变历程——从纯前端单页到 Vue 3 + Express + SQLite，从私人笔记到公开站点。","summary":"WebWord 的前身是一个纯浏览器端的本地编辑器（字体切换、Markdown、Live2D、插件市场、模板库等），后经 Vue 3 + TypeScript 重构，接入 Express + SQLite 后端，成为现在所见的多用户文档站点。本文记录了这段从“被废弃的项目改造品”到完整站点的过程。","cover":null,"assets":[{"id":"bgm","type":"audio","format":"mp3","path":"assets/music/Azure Lag - Astral Sunset.mp3","title":"Azure Lag - Astral Sunset","description":"写下这篇文章时的背景音乐"}],"key_facts":{"author":"BetaStudio2","original_project":"浏览器本地编辑器","current_stack":["Vue 3","TypeScript","Express","SQLite"],"features_original":["字体切换","Markdown 渲染","Live2D","插件市场","模板库","任务视图","音乐盒"],"official_plugins":["常数查询","化学元素周期表","随机数生成器","白噪音","天气预报","每日运势","单位换算","公式计算"],"template_categories":["日记","笔记","心得","合同","提案","PRD","周报"]},"highlights":["从纯前端本地编辑器到全栈站点","Vue 3 + TypeScript 工程化重构","Express + SQLite 后端支撑账户与文档服务","8 个官方插件 + 多类模板库","从“被废弃项目”到重新发布"],"sections":[{"id":"opening","title":"开场"},{"id":"about","title":"关于这个站点"},{"id":"predecessor","title":"前身：本地编辑器"},{"id":"evolution","title":"蜕变：从单页到全栈"},{"id":"origin","title":"内容的来处"},{"id":"future","title":"未来的期许"},{"id":"closing","title":"结语"}],"references":[],"enabled":true,"featured":false,"reading_time_minutes":6,"word_count_estimate":900},"title":"作者想说：从本地编辑器到一座小站","author":{"display_name":"BetaStudio2","avatar":"/static/avatars/BetaStudio2_b2a3f7d39caa06a5.jpg"},"comments_mode":"closed"},"en":{"content":"<style>\n.post-callout{\n  margin:0 0 32px;padding:24px 28px;\n  background:linear-gradient(135deg, rgba(96,165,250,.06) 0%, rgba(96,165,250,.02) 100%);\n  border:1px solid rgba(96,165,250,.12);\n  border-radius:10px;\n}\n.post-callout p{\n  font-size:17px;line-height:1.85;color:#c8d0da;margin:0;\n}\n.post-callout p + p{margin-top:10px}\n.post-tag-cloud{\n  display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 20px;\n}\n.post-tag{\n  display:inline-block;font-size:13px;\n  padding:5px 14px;border-radius:16px;\n  background:rgba(96,165,250,.08);color:#93c5fd;\n  border:1px solid rgba(96,165,250,.15);\n  transition:background .2s,border-color .2s;\n}\n.post-tag:hover{\n  background:rgba(96,165,250,.16);\n  border-color:rgba(96,165,250,.3);\n}\n.post-process-flow{\n  margin:20px 0 28px;padding:0;\n}\n.post-process-step{\n  display:flex;align-items:flex-start;gap:14px;\n  padding:14px 0 14px 6px;\n  position:relative;\n}\n.post-process-step:not(:last-child)::before{\n  content:'';position:absolute;\n  left:13px;top:36px;bottom:0;\n  width:1px;\n  background:rgba(255,255,255,.08);\n}\n.post-process-dot{\n  width:10px;height:10px;border-radius:50%;\n  background:rgba(96,165,250,.5);\n  box-shadow:0 0 8px rgba(96,165,250,.25);\n  flex-shrink:0;margin-top:6px;\n}\n.post-process-body h4{\n  font-size:15px;font-weight:600;margin:0 0 4px;color:#e2e6ed;\n}\n.post-process-body p{\n  font-size:14px;color:#7f8798;margin:0;line-height:1.6;\n}\n\n.post-audio-widget{\n  margin:32px 0;\n  padding:16px 20px;\n  background:rgba(255,255,255,.03);\n  border:1px solid rgba(255,255,255,.08);\n  border-radius:12px;\n}\n.post-audio-top{\n  display:flex;align-items:center;gap:14px;\n}\n.post-audio-btn{\n  width:40px;height:40px;border-radius:50%;\n  border:1px solid rgba(96,165,250,.25);\n  background:rgba(96,165,250,.08);\n  color:#93c5fd;cursor:pointer;\n  display:flex;align-items:center;justify-content:center;\n  flex-shrink:0;transition:background .2s,border-color .2s;\n  padding:0;\n}\n.post-audio-btn:hover{\n  background:rgba(96,165,250,.18);\n  border-color:rgba(96,165,250,.45);\n}\n.post-audio-btn svg{width:16px;height:16px}\n.post-audio-info{flex:1;min-width:0}\n.post-audio-title{\n  font-size:14px;font-weight:600;color:#e2e6ed;\n  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\n}\n.post-audio-artist{\n  font-size:12px;color:#7f8798;margin-top:2px;\n}\n.post-audio-time{\n  font-size:12px;color:#6b7280;flex-shrink:0;\n  font-variant-numeric:tabular-nums;\n}\n.post-audio-vol{\n  display:flex;align-items:center;gap:6px;flex-shrink:0;\n}\n.post-audio-vol-btn{\n  width:28px;height:28px;border:none;background:none;\n  color:#6b7280;cursor:pointer;display:flex;align-items:center;\n  justify-content:center;padding:0;flex-shrink:0;\n}\n.post-audio-vol-btn:hover{color:#93c5fd}\n.post-audio-vol-btn svg{width:16px;height:16px}\n.post-audio-vol-slider{\n  -webkit-appearance:none;appearance:none;\n  width:64px;height:3px;border-radius:2px;\n  background:rgba(255,255,255,.1);\n  outline:none;cursor:pointer;\n}\n.post-audio-vol-slider::-webkit-slider-thumb{\n  -webkit-appearance:none;appearance:none;\n  width:10px;height:10px;border-radius:50%;\n  background:#93c5fd;cursor:pointer;\n}\n.post-audio-vol-slider::-moz-range-thumb{\n  width:10px;height:10px;border-radius:50%;\n  background:#93c5fd;cursor:pointer;border:none;\n}\n.post-audio-track{\n  margin-top:12px;height:4px;\n  background:rgba(255,255,255,.06);\n  border-radius:2px;cursor:pointer;\n  position:relative;\n}\n.post-audio-track-filled{\n  height:100%;border-radius:2px;\n  background:linear-gradient(90deg, #60a5fa, #93c5fd);\n  width:0%;transition:width .1s linear;\n}\n.post-audio-track:hover .post-audio-track-filled{\n  background:linear-gradient(90deg, #93c5fd, #a5d0ff);\n}\n.post-audio-track-thumb{\n  position:absolute;top:50%;transform:translate(-50%,-50%);\n  width:10px;height:10px;border-radius:50%;\n  background:#93c5fd;opacity:0;\n  transition:opacity .15s;\n}\n.post-audio-track:hover .post-audio-track-thumb{opacity:1}\n\n/* ── Section refinement ── */\n.blog-post .post-section{margin-bottom:48px}\n.blog-post .post-section h2{\n  position:relative;padding-left:18px;\n}\n.blog-post .post-section h2::before{\n  content:'';position:absolute;left:0;top:4px;bottom:4px;\n  width:3px;border-radius:2px;\n  background:linear-gradient(180deg, #60a5fa 0%, rgba(96,165,250,.25) 100%);\n}\n.blog-post .post-section h3{\n  color:#c8d0da;font-size:17px;font-weight:600;\n  margin:24px 0 10px;letter-spacing:.2px;\n}\n.blog-post .post-section p{\n  color:#b0b8c4;line-height:1.85;margin:0 0 14px;\n}\n\n/* ── Callout polish ── */\n.post-callout{\n  border-left:3px solid rgba(96,165,250,.25);\n}\n\n/* ── Tag cloud polish ── */\n.post-tag{\n  transition:all .25s ease;\n}\n.post-tag:hover{\n  background:rgba(96,165,250,.2);\n  border-color:rgba(96,165,250,.35);\n  transform:translateY(-1px);\n  box-shadow:0 4px 12px rgba(96,165,250,.12);\n}\n\n/* ── Process flow polish ── */\n.post-process-flow{margin:24px 0 32px}\n.post-process-step:not(:last-child)::before{\n  background:linear-gradient(180deg, rgba(96,165,250,.25), rgba(255,255,255,.03));\n}\n.post-process-dot{\n  width:12px;height:12px;margin-top:5px;\n  background:rgba(96,165,250,.55);\n  box-shadow:0 0 10px rgba(96,165,250,.3);\n  transition:box-shadow .3s;\n}\n.post-process-step:hover .post-process-dot{\n  box-shadow:0 0 16px rgba(96,165,250,.5);\n}\n.post-process-body h4{font-size:16px;color:#e8ecf2;letter-spacing:.2px}\n\n/* ── Divider refinement ── */\n.blog-post .post-divider{\n  border:none;height:1px;margin:44px 0 36px;\n  background:linear-gradient(90deg, transparent 0%, rgba(255,255,255,.1) 20%, rgba(96,165,250,.15) 50%, rgba(255,255,255,.1) 80%, transparent 100%);\n}\n\n/* ── Blockquote highlight ── */\n.blog-post .post-blockquote-highlight{\n  position:relative;\n  padding:28px 28px 28px 32px;\n  margin:24px 0 8px;\n  background:linear-gradient(135deg, rgba(96,165,250,.08) 0%, rgba(96,165,250,.03) 100%);\n  border-left:3px solid rgba(96,165,250,.35);\n  border-radius:0 10px 10px 0;\n}\n.blog-post .post-blockquote-highlight::before{\n  content:'\\201C';\n  position:absolute;top:8px;left:14px;\n  font-size:42px;line-height:1;\n  color:rgba(96,165,250,.12);\n  font-family:Georgia,\"Times New Roman\",serif;\n  pointer-events:none;\n}\n.blog-post .post-blockquote-highlight p{\n  font-size:16px;color:#c8d0da;line-height:1.9;\n  position:relative;z-index:1;\n}\n.blog-post .post-blockquote-highlight p:first-child{\n  font-size:18px;font-weight:500;color:#e2e6ed;\n}\n\n/* ── Footer polish ── */\n.blog-post .post-footer{\n  margin-top:48px;padding-top:24px;\n  border-top:1px solid rgba(255,255,255,.06);\n}\n.blog-post .post-copyright{\n  font-size:12px;color:#4a5060;letter-spacing:.3px;\n}\n</style>\n\n<article class=\"blog-post\" data-title=\"作者想说：从本地编辑器到一座小站\">\n\n  <header class=\"post-header\">\n    <p class=\"post-meta\">\n      <span class=\"post-date\">2026-07-20</span>\n      <span> · </span>\n      <span class=\"post-category\">介绍 / 开发日记</span>\n      <span> · </span>\n      <span class=\"post-author\" data-author-uuid=\"30be-c219-f6fb-1356\">BetaStudio2</span>\n    </p>\n    <h1 class=\"post-title\">作者想说：从本地编辑器到一座小站</h1>\n    <p class=\"post-lead\">\n      写代码、写文案这件事，从一开始就是给自己找的——一块在无数次实验、无数次推翻之后，还能保持运转的小角落。\n    </p>\n  </header>\n\n  <div class=\"post-audio-widget\" id=\"audioWidget\">\n    <div class=\"post-audio-top\">\n      <button class=\"post-audio-btn\" id=\"audioBtn\" title=\"播放\">\n        <svg id=\"playIcon\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg>\n        <svg id=\"pauseIcon\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"display:none\"><path d=\"M6 19h4V5H6v14zm8-14v14h4V5h-4z\"/></svg>\n      </button>\n      <div class=\"post-audio-info\">\n        <div class=\"post-audio-title\">Azure Lag - Astral Sunset</div>\n        <div class=\"post-audio-artist\">开心点嘛</div>\n      </div>\n      <span class=\"post-audio-time\" id=\"audioTime\">0:00 / 0:00</span>\n      <div class=\"post-audio-vol\">\n        <button class=\"post-audio-vol-btn\" id=\"volBtn\" title=\"静音\">\n          <svg id=\"volOn\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z\"/></svg>\n          <svg id=\"volOff\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"display:none\"><path d=\"M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z\"/></svg>\n        </button>\n        <input type=\"range\" class=\"post-audio-vol-slider\" id=\"volSlider\" min=\"0\" max=\"100\" value=\"80\" />\n      </div>\n    </div>\n    <div class=\"post-audio-track\" id=\"audioTrack\">\n      <div class=\"post-audio-track-filled\" id=\"audioProgress\"></div>\n      <div class=\"post-audio-track-thumb\" id=\"audioThumb\"></div>\n    </div>\n  </div>\n  <audio id=\"audioEl\" preload=\"metadata\" style=\"display:none\">\n    <source src=\"/static/documents/%E4%BB%8B%E7%BB%8D/%E5%BC%80%E5%8F%91%E6%97%A5%E8%AE%B0/%E4%BD%9C%E8%80%85%E6%83%B3%E8%AF%B4/assets/music/Azure%20Lag%20-%20Astral%20Sunset.mp3\" type=\"audio/mpeg\">\n  </audio>\n\n  <script>\n  (function(){\n    var el=document.getElementById('audioEl');\n    var btn=document.getElementById('audioBtn');\n    var playI=document.getElementById('playIcon');\n    var pauseI=document.getElementById('pauseIcon');\n    var timeD=document.getElementById('audioTime');\n    var track=document.getElementById('audioTrack');\n    var prog=document.getElementById('audioProgress');\n    var thumb=document.getElementById('audioThumb');\n    var dur=0;\n    var lastVol=80;\n\n    function fmt(s){s=s|0;var m=(s/60)|0;var sec=s%60;return m+':'+(sec<10?'0':'')+sec}\n    function setVolUI(v){\n      document.getElementById('volSlider').value=v;\n      var on=document.getElementById('volOn'),off=document.getElementById('volOff');\n      on.style.display=v>0?'':'none';off.style.display=v>0?'none':'';\n    }\n\n    el.addEventListener('loadedmetadata',function(){dur=el.duration;timeD.textContent='0:00 / '+fmt(dur)});\n    el.addEventListener('timeupdate',function(){\n      var p=el.currentTime;var pc=dur?(p/dur*100):0;\n      prog.style.width=pc+'%';thumb.style.left=pc+'%';\n      timeD.textContent=fmt(p)+' / '+fmt(dur);\n    });\n    el.addEventListener('ended',function(){playI.style.display='';pauseI.style.display='none'});\n    el.addEventListener('play',function(){playI.style.display='none';pauseI.style.display=''});\n    el.addEventListener('pause',function(){playI.style.display='';pauseI.style.display='none'});\n\n    btn.addEventListener('click',function(){el.paused?el.play():el.pause()});\n    track.addEventListener('click',function(e){\n      var r=track.getBoundingClientRect();var x=e.clientX-r.left;\n      var pc=Math.min(1,Math.max(0,x/r.width));\n      el.currentTime=pc*dur;\n    });\n\n    document.getElementById('volSlider').addEventListener('input',function(){\n      var v=this.value/100;el.volume=v;lastVol=this.value;\n      setVolUI(this.value);\n    });\n    document.getElementById('volBtn').addEventListener('click',function(){\n      if(el.volume>0){lastVol=el.volume*100;el.volume=0;setVolUI(0)}\n      else{el.volume=lastVol/100;setVolUI(lastVol)}\n    });\n    el.volume=0.8;\n  })();\n  </script>\n\n  <section class=\"post-section\">\n    <div class=\"post-callout\">\n      <p>其实，本意并不是为了一个网站而做一个网站的。</p>\n      <p>那些脚本、那个本地编辑器、那堆被打回原形又重新组织的想法，它们早就在那儿了，只是从没真正站到台前过。</p>\n    </div>\n  </section>\n\n  <section class=\"post-section\">\n    <h2 id=\"about\">关于这个站点</h2>\n    <p>\n      <strong>BetaStudio2</strong>，这个站点的主开发者，也是这些文字、这些代码、这些反复推敲背后那个最较真的人。\n      当你看到这个文案时，说不定他正和协作者奋力修 bug，准备新的文案呢。\n    </p>\n    <p>\n      搭建的过程零零碎碎，前后也花了不少时间，与其让它们继续躺在硬盘里吃灰，倒不如拿出来建个站，也算给它们一个能被看见的去处。\n      所以你看到的这些页面，并不是什么宏大计划，更像是一段被搬上了台面的私人笔记。\n    </p>\n  </section>\n\n  <section class=\"post-section\">\n    <h2 id=\"predecessor\">前身：一个\"被废弃\"项目的改造品</h2>\n    <p>\n      如果往回翻一翻，你会发现这个站点的前身其实是一个所谓被\"废弃\"的项目的改造品罢了，虽然它仍然是不完美的。\n      那是一个完全跑在浏览器里的本地编辑器：字体切换、Markdown 渲染、Live2D、插件市场、模板库、任务视图、音乐盒——所有能折腾的东西，几乎都被我塞进去了。\n    </p>\n\n    <p>细看下来，光是官方插件就能数出一长串：</p>\n    <div class=\"post-tag-cloud\">\n      <span class=\"post-tag\">常数查询</span>\n      <span class=\"post-tag\">化学元素周期表</span>\n      <span class=\"post-tag\">随机数生成器</span>\n      <span class=\"post-tag\">白噪音</span>\n      <span class=\"post-tag\">天气预报</span>\n      <span class=\"post-tag\">每日运势</span>\n      <span class=\"post-tag\">单位换算</span>\n      <span class=\"post-tag\">公式计算</span>\n    </div>\n    <p>\n      每加一个，都要在不破坏既有结构的前提下，安插进一个原本没设计扩展点的内核里。\n      模板库也是，从日记、笔记、心得这种日常写作用的轻量模板，到合同、提案、PRD、周报这种偏向正式文档的模板，一点一点往上堆。\n      功能堆得再多，回头看也不过是一件陪我熬日子的工具。\n    </p>\n  </section>\n\n  <section class=\"post-section\">\n    <h2 id=\"evolution\">蜕变：从单页到全栈</h2>\n\n    <p>\n      它陪我度过了很长一段从研究课题到日常写作的过渡期，也见证了无数次\"写到一半推翻重写\"的惨案。\n      但它毕竟只是一个本地的壳，没有入口，没有归处，也没有\"被另一个人看见\"的可能。\n    </p>\n    <p>于是就有了现在的站点：</p>\n\n    <div class=\"post-process-flow\">\n      <div class=\"post-process-step\">\n        <div class=\"post-process-dot\"></div>\n        <div class=\"post-process-body\">\n          <h4>拆解</h4>\n          <p>把那块本地编辑器拆开，留下内核。</p>\n        </div>\n      </div>\n      <div class=\"post-process-step\">\n        <div class=\"post-process-dot\"></div>\n        <div class=\"post-process-body\">\n          <h4>重构</h4>\n          <p>从纯前端的单页，搬到了 <strong>Vue 3 + TypeScript</strong> 的工程结构上。</p>\n        </div>\n      </div>\n      <div class=\"post-process-step\">\n        <div class=\"post-process-dot\"></div>\n        <div class=\"post-process-body\">\n          <h4>接入</h4>\n          <p>在背后接上 <strong>Express</strong> 和 <strong>SQLite</strong>，撑起了账户、文档、回收站这些原本不存在的服务。</p>\n        </div>\n      </div>\n      <div class=\"post-process-step\">\n        <div class=\"post-process-dot\"></div>\n        <div class=\"post-process-body\">\n          <h4>裁剪</h4>\n          <p>一边拆，一边补，一边砍掉那些在多人场景下已经不合时宜的边角。</p>\n        </div>\n      </div>\n    </div>\n\n    <p>\n      等这些都收拾完，原本那个\"本地编辑器\"其实已经换了一副骨架。\n      所以严格说起来，你现在看到的不是\"一个新项目\"，而是那个本地编辑器的一次<strong>重新发布</strong>。\n    </p>\n  </section>\n\n  <section class=\"post-section\">\n    <h2 id=\"origin\">内容的来处</h2>\n    <p>\n      你能在这边读到的关于 Kimi K3、长程编程、长文档、心得笔记，几乎每一篇，最初都是在那块本地编辑器里被敲出来的。\n      我只是把草稿箱、废稿箱、试验场，按主题重新整理了一遍，又加上了账户、搜索、导航、回收站这些\"让站点像个站点\"的零件。\n    </p>\n    <p>\n      每一篇都还带着当时敲下它的那台电脑、那个凌晨、那首循环的歌的影子，只是被重新归档、重新打磨，重新摆到了能被人翻到的位置上。\n    </p>\n  </section>\n\n  <section class=\"post-section\">\n    <h2 id=\"future\">未来的期许</h2>\n    <p>\n      如果未来这里能攒下一些真正有用，或者至少有点温度的内容，那就已经超出我最开始那个\"让硬盘里的东西见见光\"的预期了。\n      剩下的，就一边写，一边慢慢来吧。\n    </p>\n  </section>\n\n  <section class=\"post-section\">\n    <hr class=\"post-divider\" />\n\n    <p>\n      不过话说回来，再用心，也拦不住时间。或许，总有那么一段时间，这个小站会随着时间的流逝，逐渐泯灭。\n      这或许是每个人都不愿意经历的结局。但是至少——现在的它，在维护与改进之下，在逐渐变好。\n    </p>\n\n    <blockquote class=\"post-blockquote post-blockquote-highlight\">\n      <p>\"开心点嘛。\"</p>\n      <p>至少现在的我们，都在变好。对吧。</p>\n    </blockquote>\n  </section>\n\n  <footer class=\"post-footer\">\n    <p class=\"post-copyright\">本文为个人随笔，版权所有 &copy; BetaStudio2</p>\n  </footer>\n\n</article>","meta":{"id":"author-notes","title":"作者想说：从本地编辑器到一座小站","subtitle":"关于 WebWord 的前世今生——一次从私人工具到公共站点的蜕变记录","category":"介绍/开发日记/作者想说","tags":["开发日记","WebWord","BetaStudio2","本地编辑器","Vue 3","TypeScript","Express","SQLite","全栈","开源"],"author_uuid":"a2c9-2c8d-0967-620e","version":"v1.0.0","status":"published","format":"domt","filename":"作者想说.domt","language":"zh-CN","created":"2026-07-20","updated":"2026-07-20","published_at":"2026-07-20T00:00:00+08:00","description":"BetaStudio2 讲述 WebWord 从本地编辑器到全栈站点的蜕变历程——从纯前端单页到 Vue 3 + Express + SQLite，从私人笔记到公开站点。","summary":"WebWord 的前身是一个纯浏览器端的本地编辑器（字体切换、Markdown、Live2D、插件市场、模板库等），后经 Vue 3 + TypeScript 重构，接入 Express + SQLite 后端，成为现在所见的多用户文档站点。本文记录了这段从“被废弃的项目改造品”到完整站点的过程。","cover":null,"assets":[{"id":"bgm","type":"audio","format":"mp3","path":"assets/music/Azure Lag - Astral Sunset.mp3","title":"Azure Lag - Astral Sunset","description":"写下这篇文章时的背景音乐"}],"key_facts":{"author":"BetaStudio2","original_project":"浏览器本地编辑器","current_stack":["Vue 3","TypeScript","Express","SQLite"],"features_original":["字体切换","Markdown 渲染","Live2D","插件市场","模板库","任务视图","音乐盒"],"official_plugins":["常数查询","化学元素周期表","随机数生成器","白噪音","天气预报","每日运势","单位换算","公式计算"],"template_categories":["日记","笔记","心得","合同","提案","PRD","周报"]},"highlights":["从纯前端本地编辑器到全栈站点","Vue 3 + TypeScript 工程化重构","Express + SQLite 后端支撑账户与文档服务","8 个官方插件 + 多类模板库","从“被废弃项目”到重新发布"],"sections":[{"id":"opening","title":"开场"},{"id":"about","title":"关于这个站点"},{"id":"predecessor","title":"前身：本地编辑器"},{"id":"evolution","title":"蜕变：从单页到全栈"},{"id":"origin","title":"内容的来处"},{"id":"future","title":"未来的期许"},{"id":"closing","title":"结语"}],"references":[],"enabled":true,"featured":false,"reading_time_minutes":6,"word_count_estimate":900},"title":"作者想说：从本地编辑器到一座小站","author":{"display_name":"BetaStudio2","avatar":"/static/avatars/BetaStudio2_b2a3f7d39caa06a5.jpg"},"comments_mode":"closed"}}